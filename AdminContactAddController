using Azure.Core;
using Microsoft.AspNetCore.Mvc;
using Victory.Data;
using Victory.Entity;

namespace Victory.Controllers
{
    public class AdminContactAddController : Controller
    {
        public readonly VictoryContext _context;

        public AdminContactAddController(VictoryContext context)
        {
            _context = context;
        }
        public IActionResult ContactAdd()
        {
            return View();
        }
        [HttpPost]
        public IActionResult ContactAdd(Contact a)
        {
            if (ModelState.IsValid)
            {
                _context.Contacts.Add(a);
                _context.SaveChanges();
                return RedirectToAction("Index","AdminPanel");
            }
            return View();
        }
        [HttpGet]
        public IActionResult ContactEdit(int id)
        {
            var contact = _context.Contacts.Find(id);
            if (contact == null) return NotFound();

            var model = new Contact();

            model.Banner = contact.Banner;
            model.Description = contact.Description;
            model.Address = contact.Address;
            model.Iframe = contact.Iframe;

            return View(model);
        }
        [HttpPost]
        public IActionResult ContactEdit(int id, Contact model)
        {
            if (!ModelState.IsValid) return View(model);

            var contact = _context.Contacts.Find(id);
            if (contact == null) return NotFound();

            contact.Banner = model.Banner;
            contact.Description = model.Description;
            contact.Address = model.Address;
            contact.Iframe = model.Iframe;

            _context.SaveChanges();
            return RedirectToAction("Index","AdminPanel");
        }
        [HttpPost]
        public IActionResult ContactDelete(int id)
        {
            var contact = _context.Contacts.Find(id);

            if (contact != null)
            {
                _context.Contacts.Remove(contact);
                _context.SaveChanges();
            }

            return RedirectToAction("Index", "AdminPanel");
        }
    }
}
